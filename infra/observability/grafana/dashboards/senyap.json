  {
   "id": 6,
   "type": "timeseries",
   "title": "Latensi pesan",
   "description": "Kirim→terima ≈ send→ack + delivery lag. Target NFR-10: p95 < 500 ms.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(senyap_rt_send_latency_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95 msg.send→ack (gateway)"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(senyap_chat_delivery_lag_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95 tersimpan→msg.new ke gateway"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.50, sum(rate(senyap_chat_delivery_lag_seconds_bucket[5m])) by (le))",
     "legendFormat": "p50 tersimpan→msg.new"
    }
   ]
  },
